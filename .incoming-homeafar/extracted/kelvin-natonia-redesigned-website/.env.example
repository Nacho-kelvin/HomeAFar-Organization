# Copy to .env.local for local work, and add the same two values in Vercel > Project > Settings > Environment Variables.
# Supabase Dashboard > Project Settings > API. Use the anon/public key ONLY. NEVER add the service_role key to this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
